# ---- Java / Gradle ----
build/
.gradle/
out/
*.class
*.jar
!gradle-wrapper.jar
*.war
target/

# ---- Node / Vite ----
node_modules/
dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDE ----
.idea/
*.iml
.project
.classpath
.settings/
*.swp
# .vscode/ is intentionally NOT ignored — teammate's settings are committed

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Secrets / env ----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- Binaries (future) ----
# The existing kind.exe files are kept as committed.
# This rule stops new .exe/.so/.dylib files from being added.
*.exe
*.dll
*.so
*.dylib

# ---- Misc ----
*.tmp
*.bak
